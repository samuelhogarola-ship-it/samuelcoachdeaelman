RewriteCond %{REQUEST_URI} ^/f/la-voz-pasiva-con-verbos-modales-en-alem%C3%A1n-passiv-mit-modalverben/?$ [NC]
RewriteRule ^ /f/la-voz-pasiva-con-verbos-modales-en-aleman-passiv-mit-modalverben/ [R=301,L,QSD]

RewriteCond %{REQUEST_URI} ^/f/el-imperativo-en-alem%C3%A1n/?$ [NC]
RewriteRule ^ /f/el-imperativo-en-aleman/ [R=301,L,QSD]

