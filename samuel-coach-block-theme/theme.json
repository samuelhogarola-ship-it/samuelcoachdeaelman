{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "teal", "name": "Teal", "color": "#3aa9ab" },
        { "slug": "teal-dark", "name": "Teal Dark", "color": "#2c8182" },
        { "slug": "dark", "name": "Dark", "color": "#0d3637" },
        { "slug": "navy", "name": "Navy", "color": "#455a64" },
        { "slug": "text", "name": "Text", "color": "#1b1b1b" },
        { "slug": "muted", "name": "Muted", "color": "#525252" },
        { "slug": "soft", "name": "Soft", "color": "#f6f6f6" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "Sans",
          "slug": "sans"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.9rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.35rem", "name": "Large" },
        { "slug": "x-large", "size": "2.4rem", "name": "XL" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#1b1b1b"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "22px",
            "right": "22px"
          }
        },
        "typography": {
          "fontWeight": "700"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
